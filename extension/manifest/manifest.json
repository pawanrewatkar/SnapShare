{
  "manifest_version": 3,
  "name": "SnapShare – Screenshot, Record & Share",
  "short_name": "SnapShare",
  "version": "0.0.0",
  "description": "Capture screenshots and full pages, record your tab or screen, annotate, and share via your own Google Drive.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "SnapShare", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "tabCapture", "offscreen", "storage", "unlimitedStorage", "downloads", "identity", "clipboardWrite"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "commands": {
    "capture-default": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Capture with the default mode" },
    "capture-visible": { "suggested_key": { "default": "Alt+Shift+V" }, "description": "Capture visible area" },
    "capture-region": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Capture selected region" },
    "capture-fullpage": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Capture full page" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
