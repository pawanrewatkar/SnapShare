# Public base URL of this site (used for OAuth redirect and share links). No trailing slash.
APP_BASE_URL=http://localhost:3000

# Google OAuth "Web application" client (Google Cloud Console > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase project (Settings > API). The service role key must stay server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random secrets. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# 32 bytes, base64. Encrypts Google refresh tokens and share-link tokens at rest.
ENCRYPTION_KEY=
# Comma-separated Chrome extension IDs allowed to sign in (chrome://extensions shows the ID).
ALLOWED_EXTENSION_IDS=
# Secret for Vercel Cron calls to /api/cron/expire-shares
CRON_SECRET=
